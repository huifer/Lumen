# 有 Key 走 Gemini 在线多模态；不填则自动降级为离线模式
GEMINI_API_KEY=

# 模型 ID 留空 = 运行时自动发现当前 Key 可用的最新模型（推荐）
# 需要固定版本时手动指定，例如：
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_MODEL=
GEMINI_EMBED_MODEL=

# 向量维度（gemini-embedding-001 支持 768/1536/3072；text-embedding-004 仅 768）
EMBED_DIM=1536

# 可选：tesseract OCR 语言与可执行文件路径
OCR_LANGS=chi_sim+eng
TESSERACT_BIN=tesseract
